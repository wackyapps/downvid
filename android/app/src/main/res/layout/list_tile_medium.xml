<?xml version="1.0" encoding="utf-8"?>
<!-- Root container for the entire Native Ad -->
<!-- AdMob automatically fills the views with real ad content -->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Main white card that holds everything -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@android:color/white">

        <!-- ROW 1: Image + Text (left: ad image/video, right: title + app name) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1. Shows the ad's main image or short video -->
            <!-- 80×60 dp = perfect Facebook-style size -->
            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_gravity="center_vertical"
                android:scaleType="centerCrop"/>

            <!-- Right side: headline and advertiser name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- 2. Main ad title (e.g., "Get 50% off today!") -->
                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <!-- 3. App or brand name (e.g., "Daraz", "Google Ads") -->
                <TextView
                    android:id="@+id/ad_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: Blue Call-to-Action button (Install / Learn More / Shop Now) -->
        <!-- Positioned at bottom right, just like Facebook -->
        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#FF3B82F6"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>